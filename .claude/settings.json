{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BEADS_DIR": "/workspace/.beads",
    "FEATURE_MEMORY": "true"
  },
  "permissions": {
    "deny": [
      "Read(./.entire/metadata/**)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'NAME=$(cat | jq -r .name); DIR=\"/tmp/claude-worktrees/$NAME\"; mkdir -p /tmp/claude-worktrees && git worktree add \"$DIR\" -b \"worktree-$NAME\" >&2 && echo \"$DIR\"'"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'WTPATH=$(cat | jq -r .worktree_path); git worktree remove \"$WTPATH\" 2>/dev/null; rm -rf \"$WTPATH\" 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
   },
  "statusLine": {
    "type": "command",
    "command": "python3 /workspace/.claude/scripts/claude-context-bar.py"
  },
  "enabledPlugins": {
    "metapowers@metapowers": true
  },
  "skipDangerousModePermissionPrompt": true
}
