{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "command": "vite dev",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "vite build",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  }
}
